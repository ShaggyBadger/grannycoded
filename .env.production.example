# Production environment for the GrannyCoded storefront.
#
# Copy to .env beside compose.prod.yaml on the server, fill in every blank
# value, and keep it out of Git (the repository ignores .env). Never reuse the
# local development secret key or database password.
#
#   cp .env.production.example .env && chmod 600 .env

# --- Host and site identity ------------------------------------------------
# The hostname Caddy serves and requests a certificate for. It must already
# resolve to this server, with ports 80 and 443 open.
SITE_DOMAIN=grannycoded.com

DJANGO_DEBUG=False
# Generate a new one: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=grannycoded.com,www.grannycoded.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://grannycoded.com,https://www.grannycoded.com
WAGTAIL_SITE_NAME=GrannyCoded
WAGTAILADMIN_BASE_URL=https://grannycoded.com
# Canonical origin for SEO metadata, the sitemap, and robots.txt.
PUBLIC_SITE_URL=https://grannycoded.com
# Optional: Search Console HTML-tag verification content value.
GOOGLE_SITE_VERIFICATION=

# HTTP Strict Transport Security. Start at 3600 while the domain settles, then
# raise to 31536000. Only enable include-subdomains if every subdomain is HTTPS.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False

# --- Database --------------------------------------------------------------
# Only the db container uses these; Django reaches it at DATABASE_HOST=db.
POSTGRES_DB=website
POSTGRES_USER=website
POSTGRES_PASSWORD=
DATABASE_HOST=db
DATABASE_PORT=5432

# --- Media -----------------------------------------------------------------
# Production images live in the site's own Linode bucket. Keep the location
# prefix identical to the one used in development so stored file names resolve.
# Fill in every LINODE_ value below, or set this to False to start on the local
# media volume (uploaded files then live only on this server).
USE_LINODE_OBJECT_STORAGE=True
LINODE_STORAGE_ENDPOINT=
LINODE_STORAGE_REGION=
LINODE_STORAGE_BUCKET_NAME=
LINODE_STORAGE_LOCATION=images/public
LINODE_STORAGE_DEFAULT_ACL=public-read
LINODE_PRIVATE_STORAGE_LOCATION=images/private
LINODE_ACCESS_KEY_ID=
LINODE_SECRET_ACCESS_KEY=

# --- Email -----------------------------------------------------------------
# Leave EMAIL_HOST blank to keep order and inquiry mail switched off.
CUSTOM_ORDER_NOTIFICATION_EMAIL=
ORDER_NOTIFICATION_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# --- Payments --------------------------------------------------------------
# Start with test keys so the site is browsable while checkout stays in test
# mode. Switch to live keys, STRIPE_LIVE_MODE=True, and the live webhook's own
# signing secret together; a mismatch closes checkout on purpose.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_MODE=False
STRIPE_CURRENCY=usd
STRIPE_CHECKOUT_EXPIRY_MINUTES=35
