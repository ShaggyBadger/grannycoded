# Local development settings. scripts/init.sh creates .env and configures the site name/key.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
WAGTAIL_SITE_NAME=New Website
WAGTAILADMIN_BASE_URL=http://localhost:8000
# Canonical origin used by SEO metadata, the sitemap, and robots.txt.
PUBLIC_SITE_URL=http://localhost:8000
# Optional: Google Search Console HTML-tag verification content value.
GOOGLE_SITE_VERIFICATION=
# Optional: configure both the recipient and mail transport to email custom-order requests.
CUSTOM_ORDER_NOTIFICATION_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
# Where new paid orders are announced. Defaults to CUSTOM_ORDER_NOTIFICATION_EMAIL.
ORDER_NOTIFICATION_EMAIL=

# Django connects to the Postgres service by its Compose service name.
DATABASE_HOST=db
DATABASE_PORT=5432
POSTGRES_DB=website
POSTGRES_USER=website
POSTGRES_PASSWORD=local-development-only-change-me

# Optional Linode Object Storage for images only. The bucket stays private;
# public image objects get public-read ACLs and customer reference uploads stay private.
USE_LINODE_OBJECT_STORAGE=False
LINODE_STORAGE_ENDPOINT=
LINODE_STORAGE_REGION=
LINODE_STORAGE_BUCKET_NAME=
LINODE_STORAGE_LOCATION=images/public
LINODE_STORAGE_DEFAULT_ACL=public-read
LINODE_PRIVATE_STORAGE_LOCATION=images/private
LINODE_ACCESS_KEY_ID=
LINODE_SECRET_ACCESS_KEY=

# Stripe payments. Checkout stays closed until STRIPE_SECRET_KEY is present.
# Start with test-mode keys (pk_test_/sk_test_).
#
# Keep exactly one STRIPE_SECRET_KEY line uncommented, and make it agree with
# STRIPE_LIVE_MODE. Local development uses the test key; the server uses the
# live key with STRIPE_LIVE_MODE=True. Django closes checkout if the two
# disagree, so a half-finished switch cannot quietly charge a real card.
STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=sk_test_or_rk_test_key_here
# STRIPE_SECRET_KEY=sk_live_or_rk_live_key_here
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_MODE=False
STRIPE_CURRENCY=usd
# Minutes a basket holds its stock while the Stripe page is open. Stripe requires
# its own session to last at least 30 minutes, so keep this above that.
STRIPE_CHECKOUT_EXPIRY_MINUTES=35
